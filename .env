# Directory to watch for new files (default: C:/Users/Administrator/Downloads)
WATCH_DIR=C:/Users/Administrator/Downloads

# Upload endpoint URL (default: http://localhost:3001/vn/file)
API_URL=https://www.dadaex.cn/api/vn/file

# Log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# Mail notification (errors + upload success)
MAIL_TO=904288354@qq.com
